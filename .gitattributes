# Einheitliche Zeilenenden: im Repository immer LF
* text=auto eol=lf
# Shell-Skripte müssen LF haben, sonst laufen sie in der Linux-Cloud nicht
*.sh text eol=lf
# Windows-Skripte mit CRLF
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
# Binärdateien
*.png binary
*.ico binary
*.icns binary
